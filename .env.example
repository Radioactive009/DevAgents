# =====================================================================
# DevAgents Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or credentials to source control!
# =====================================================================

# LLM Providers (Configure at least one)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HF_API_KEY=your_huggingface_api_key_here

# GitHub Integration
# Preferred authentication: Run 'gh auth login' using the GitHub CLI.
# Fallback authentication:
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# GITHUB_USER=your_github_username

# Vercel Cloud Deployment Integration
# Obtain from: https://vercel.com/account/tokens (Scope: Full Account or Team Access)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=
